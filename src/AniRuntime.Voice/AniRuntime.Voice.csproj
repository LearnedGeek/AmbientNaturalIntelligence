<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AniRuntime.Core\AniRuntime.Core.csproj" />
    <ProjectReference Include="..\AniRuntime.LLM\AniRuntime.LLM.csproj" />
    <!-- Theme R.7 (#64, 2026-05-24) — voice routes through ContextBuilder
         (in AniRuntime.Loops) so it inherits R.1-R.6 architectural-input
         wiring. Loops does not reference Voice, so no circular dep. -->
    <ProjectReference Include="..\AniRuntime.Loops\AniRuntime.Loops.csproj" />
    <!-- 2026-05-20 — tag-mapping subsystem moved from LearnedGeek.ML to here
         per learnedgeek-libs Issue #2. Library reference needed for the
         ITextClassificationService dependency in MLVoiceTagEnricher. -->
    <ProjectReference Include="..\..\..\learnedgeek-libs\LearnedGeek.ML\LearnedGeek.ML.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="TagMapping\StaticTagMap.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AniRuntime.Tests" />
  </ItemGroup>

</Project>
