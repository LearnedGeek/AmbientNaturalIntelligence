{
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:5100" }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Ollama": {
    "BaseUrl":              "http://localhost:11434",
    "ChatModel": "ani-v7-conversation",
    "InnerMonologueModel": "ani-v7-inner",
    "EmbedModel":           "nomic-embed-text"
  },
  "Rss": {
    "Enabled": true,
    "MaxItemsPerFeed": 2,
    "Feeds": [
      { "Name": "NPR Books",   "Url": "https://feeds.npr.org/1032/rss.xml" },
      { "Name": "Bon Appétit", "Url": "https://www.bonappetit.com/feed/rss" },
      { "Name": "NPR News",    "Url": "https://feeds.npr.org/1001/rss.xml" }
    ]
  },
  "Ani": {
    "DesireLambdaMinutes":    8.0,
    "ThinkTargetProbability": 0.70,
    "MinWakeMinutes":         2.0,
    "MaxWakeMinutes":         45.0,
    "CooldownMinutes":          20.0,
    "MinOutreachGapMinutes":    60.0,
    "MaxNightOutreach":         1,
    "MaxOutreachPerDay":        4,
    "OutreachThresholdFloor":   0.55,
    "OutreachThresholdRange":   0.30,
    "DriftPerHour":             0.08,
    "DriftCapPerCycle":         0.4,
    "TriggerDesireMultiplier":  0.15,
    "ValenceTriggerThreshold":  0.75,
    "ConversationHeartbeatSeconds": 45.0,
    "ConversationTimeoutMinutes":   15.0,
    "ReactiveShareThreshold":       0.6,
    "MaxReactiveSharesPerDay":      2,
    "ReactiveShareCooldownMinutes": 20.0,
    "TensionOnsetHours":            18.0,
    "TensionAccumulationRate":      0.004,
    "TensionMax":                   0.4,
    "TensionDissipationMultiplier": 3.0,
    "CharacterStatePath":       "data/character-state.json",
    "MemoryDbPath":             "data/ani-memory.db",
    "ClassifyDir":              "",
    "ClassifierResultsPath":    "",
    "RuminationGuardEnabled":        true,
    "RuminationSimilarityThreshold": 0.75,
    "RuminationClusterMinSize":      3,
    "RuminationWindowHours":         2.0,
    "OutreachEnabled":               true
  },
  "Twilio": {
    "InboundEnabled": true
  },
  "Weather": {
    "Enabled": true,
    "Latitude": 43.11,
    "Longitude": -88.49,
    "PollIntervalMinutes": 30
  },
  "Emergence": {
    "Enabled": true,
    "EmergenceDbPath": "data/ani-emergence.db"
  },
  "Diagnostic": {
    "Enabled": true,
    "IntervalMinutes": 10,
    "LogLinesToScan": 500,
    "AutoCorrectEnabled": true,
    "AutoCorrectAllowlist": ["RETRIEVAL-POISON"]
  },
  "Images": {
    "Enabled": false,
    "LibraryPath": "data/images",
    "MaxImagesPerDay": 2,
    "AttachmentProbability": 0.20
  },
  "Voice": {
    "Enabled": false,
    "ElevenLabsModelId": "eleven_v3",
    "WhisperModel": "whisper-1",
    "VoiceGreeting": "Hey! What's up?",
    "VoiceRecordMaxSeconds": 30,
    "VoiceRecordTimeoutSeconds": 5,
    "VoiceTurnTimeoutMs": 18000,
    "PreferVoiceOverSms": false,
    "PublicBaseUrl": "",
    "ElevenLabsStreamingModelId": "eleven_multilingual_v2",
    "StreamingEnabled": false,
    "DeepgramApiKey": "",
    "DeepgramModel": "nova-3",
    "DeepgramEndpointingMs": 500
  }
}
