{
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://localhost:5100" }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Ollama": {
    "BaseUrl":              "http://localhost:11434",
    "ChatModel":            "ani-v3-conversation",
    "InnerMonologueModel":  "ani-v3.5-inner",
    "EmbedModel":           "nomic-embed-text"
  },
  "Rss": {
    "Enabled": true,
    "MaxItemsPerFeed": 2,
    "Feeds": [
      { "Name": "NPR Books",   "Url": "https://feeds.npr.org/1032/rss.xml" },
      { "Name": "Bon Appétit", "Url": "https://www.bonappetit.com/feed/rss" },
      { "Name": "NPR News",    "Url": "https://feeds.npr.org/1001/rss.xml" }
    ]
  },
  "Ani": {
    "DesireLambdaMinutes":    8.0,
    "ThinkTargetProbability": 0.70,
    "MinWakeMinutes":         2.0,
    "MaxWakeMinutes":         45.0,
    "CooldownMinutes":          20.0,
    "MinOutreachGapMinutes":    60.0,
    "MaxOutreachPerDay":        4,
    "OutreachThresholdFloor":   0.55,
    "OutreachThresholdRange":   0.30,
    "DriftPerHour":             0.08,
    "DriftCapPerCycle":         0.4,
    "TriggerDesireMultiplier":  0.15,
    "ValenceTriggerThreshold":  0.75,
    "ConversationHeartbeatSeconds": 45.0,
    "ConversationTimeoutMinutes":   15.0,
    "ReactiveShareThreshold":       0.6,
    "MaxReactiveSharesPerDay":      2,
    "ReactiveShareCooldownMinutes": 20.0,
    "CharacterStatePath":       "data/character-state.json",
    "MemoryDbPath":             "data/ani-memory.db"
  },
  "Twilio": {
    "InboundEnabled": true
  }
}
