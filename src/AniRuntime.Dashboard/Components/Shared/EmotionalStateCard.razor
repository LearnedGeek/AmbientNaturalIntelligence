@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public float Value { get; set; }
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}

<article @onclick="OnClick"
         style="cursor: pointer; border: 2px solid @(IsSelected ? AccentColor : "transparent"); transition: border-color 0.2s;">
    <header>@Label</header>
    <progress value="@Value" max="1" style="@(IsSelected ? $"--pico-progress-color: {AccentColor};" : "")"></progress>
    <small>@Value.ToString("F2")</small>
</article>

@code {
    private string AccentColor => Label switch
    {
        "Warmth" => "#4caf50",
        "Energy" => "#2196f3",
        "Worry" => "#ff9800",
        "Playfulness" => "#9c27b0",
        _ => "#607d8b",
    };
}
