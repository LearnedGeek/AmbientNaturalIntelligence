@page "/classification"
@using AniRuntime.Core.Interfaces
@using AniRuntime.Core.Models
@using LearnedGeek.ML
@using LearnedGeek.ML.Interfaces
@using LearnedGeek.ML.Models
@inject IMemoryAnalytics MemoryAnalytics
@inject IMemoryPersistence MemoryPersistence
@inject ITextClassificationService MLClassifier
@inject ClassificationComparisonService ComparisonService

<h1>Classification Comparison</h1>
<p><em>Heuristic registers vs LM-Kit ML classification — side by side</em></p>

<div style="display: flex; gap: 1rem; align-items: center; margin-bottom: 1rem;">
    <button @onclick="RunScan" disabled="@ComparisonService.ScanInProgress"
            style="padding: 0.5em 1.2em; border-radius: 4px; background: #2196f3; color: white; border: none; cursor: pointer; font-weight: bold;">
        @(ComparisonService.ScanInProgress ? "Scanning..." : "Run Scan")
    </button>
    <select @bind="_scanDays" style="padding: 0.4em; border-radius: 4px; background: rgba(255,255,255,0.1); color: inherit; border: 1px solid rgba(255,255,255,0.2);">
        <option value="7">7 days</option>
        <option value="30">30 days</option>
        <option value="90">90 days</option>
        <option value="180">6 months</option>
        <option value="365">1 year</option>
        <option value="9999">All time</option>
    </select>
    <button @onclick="RunBackfill" disabled="@_backfillInProgress"
            style="padding: 0.5em 1.2em; border-radius: 4px; background: #ff9800; color: white; border: none; cursor: pointer; font-weight: bold;">
        @(_backfillInProgress ? "Backfilling..." : "Backfill Nulls")
    </button>
    @if (_divergenceTrend.Count > 0)
    {
        <small style="opacity: 0.6;">Trend: @_divergenceTrend.Count days loaded</small>
    }
    else
    {
        <small style="opacity: 0.6;">Trend: @_totalWithDivergence contributions with divergence data</small>
    }
    <small style="opacity: 0.6;">
        @if (_scanStatus is not null)
        {
            @_scanStatus
        }
        else if (ComparisonService.LatestSummary is not null)
        {
            <text>Last scan: @ComparisonService.LatestSummary.ScanTimestamp.LocalDateTime.ToString("h:mm tt") — @ComparisonService.LatestSummary.TotalCompared items</text>
        }
    </small>
</div>

@if (_divergenceTrend.Count > 0)
{
    <section>
        <h3>Divergence Trend</h3>
        <small style="opacity: 0.6;">Average state-expression divergence per day (0 = aligned, 1 = divergent)</small>
        <div style="display: flex; align-items: flex-end; gap: 2px; height: 120px; margin-top: 0.5rem; padding: 0.5rem 0;">
            @foreach (var day in _divergenceTrend)
            {
                var barHeight = Math.Max(day.AvgDivergence * 100, 2);
                var barColor = day.AvgDivergence >= 0.70f ? "#f44336" : day.AvgDivergence >= 0.40f ? "#ff9800" : "#4caf50";
                <div style="display: flex; flex-direction: column; align-items: center; flex: 1; min-width: 20px;">
                    <small style="font-size: 0.6em; opacity: 0.5; margin-bottom: 2px;">@day.Count</small>
                    <div style="width: 100%; max-width: 40px; height: @(barHeight)px; background: @barColor; border-radius: 2px 2px 0 0;"
                         title="@day.Date.ToString("MMM d"): avg @day.AvgDivergence.ToString("F2") (@day.Count items)"></div>
                    <small style="font-size: 0.6em; opacity: 0.4; margin-top: 2px;">@day.Date.ToString("M/d")</small>
                </div>
            }
        </div>
    </section>
}

@if (ComparisonService.LatestSummary is not null)
{
    var s = ComparisonService.LatestSummary;
    <section>
        <h3>Summary</h3>
        <div class="grid">
            <article>
                <header>Total Compared</header>
                <div style="text-align: center;">
                    <p style="font-size: 2em; margin: 0;">@s.TotalCompared</p>
                </div>
            </article>
            <article>
                <header>Tag Agreement</header>
                <div style="text-align: center;">
                    <p style="font-size: 2em; margin: 0; color: @AgreementColor(s.TagAgreementRate)">@s.TagAgreementRate.ToString("P0")</p>
                    <small>@s.TagMatches / @s.TotalCompared</small>
                </div>
            </article>
            <article>
                <header>Emotion Alignment</header>
                <div style="text-align: center;">
                    <p style="font-size: 2em; margin: 0; color: @AgreementColor(s.EmotionAgreementRate)">@s.EmotionAgreementRate.ToString("P0")</p>
                    <small>@s.EmotionAlignments / @s.TotalCompared</small>
                </div>
            </article>
        </div>
    </section>

    <section>
        <h3>ML Emotion Distribution</h3>
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
            @foreach (var kvp in s.MLEmotionDistribution.OrderByDescending(x => x.Value))
            {
                var pct = (float)kvp.Value / s.TotalCompared;
                <div style="padding: 0.4em 0.8em; background: rgba(33,150,243,0.15); border-radius: 4px; font-size: 0.9em;">
                    <strong>@kvp.Key</strong> @kvp.Value <small style="opacity: 0.6;">(@pct.ToString("P0"))</small>
                </div>
            }
        </div>
    </section>

    <section>
        <h3>Heuristic Register Distribution</h3>
        <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
            @foreach (var kvp in s.HeuristicRegisterDistribution.OrderByDescending(x => x.Value))
            {
                var pct = (float)kvp.Value / s.TotalCompared;
                <div style="padding: 0.4em 0.8em; background: rgba(156,39,176,0.15); border-radius: 4px; font-size: 0.9em;">
                    <strong>@kvp.Key</strong> @kvp.Value <small style="opacity: 0.6;">(@pct.ToString("P0"))</small>
                </div>
            }
        </div>
    </section>
}

@if (ComparisonService.Comparisons.Count > 0)
{
    <section>
        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
            <h3 style="margin: 0;">Detailed Comparison</h3>
            <div style="margin-left: auto; display: flex; gap: 0.3rem;">
                <button @onclick="@(() => _sortBy = "confidence")"
                        style="padding: 0.2em 0.5em; border-radius: 4px; background: @(_sortBy == "confidence" ? "rgba(255,255,255,0.2)" : "rgba(255,255,255,0.05)"); color: inherit; border: none; cursor: pointer; font-size: 0.8em;">Confidence</button>
                <button @onclick="@(() => _sortBy = "disagreements")"
                        style="padding: 0.2em 0.5em; border-radius: 4px; background: @(_sortBy == "disagreements" ? "rgba(255,255,255,0.2)" : "rgba(255,255,255,0.05)"); color: inherit; border: none; cursor: pointer; font-size: 0.8em;">Disagreements</button>
                <button @onclick="@(() => _sortBy = "all")"
                        style="padding: 0.2em 0.5em; border-radius: 4px; background: @(_sortBy == "all" ? "rgba(255,255,255,0.2)" : "rgba(255,255,255,0.05)"); color: inherit; border: none; cursor: pointer; font-size: 0.8em;">All</button>
            </div>
        </div>

        @{
            var sorted = GetSortedComparisons();
        }

        <div style="max-height: 600px; overflow-y: auto;">
            @foreach (var c in sorted.Take(100))
            {
                var alignColor = c.EmotionAligns ? "#4caf50" : "#f44336";
                var tagColor = c.TagsMatch ? "#4caf50" : "#ff9800";
                var isExpanded = _expandedItems.Contains(c.Id);
                <div style="border-left: 3px solid @alignColor; padding: 0.4em 0.8em; margin-bottom: 0.3rem; background: rgba(255,255,255,0.03);">
                    <div style="display: flex; justify-content: space-between; align-items: baseline; cursor: pointer;"
                         @onclick="() => ToggleExpand(c.Id)">
                        <span style="font-size: 0.85em; @(isExpanded ? "" : "overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 55%;")">
                            @(string.IsNullOrEmpty(c.SourceContent) ? "(no source)" : c.SourceContent)
                        </span>
                        <span style="font-size: 0.8em; white-space: nowrap; margin-left: 0.5em;">
                            <span style="color: #9c27b0;">@c.HeuristicRegister</span>
                            →
                            <span style="color: #2196f3; font-weight: bold;">@c.MLEmotion (@c.MLConfidence.ToString("F2"))</span>
                            <span style="color: @alignColor; margin-left: 0.3em;">@(c.EmotionAligns ? "✓" : "✗")</span>
                        </span>
                    </div>
                    @if (isExpanded)
                    {
                        <div style="font-size: 0.75em; opacity: 0.6; margin-top: 0.3em;">
                            Heuristic: @c.HeuristicCategory / @c.HeuristicRegister (sev @c.HeuristicSeverity.ToString("F2"))
                            | ML: @c.MLEmotion (@c.MLConfidence.ToString("F2"))
                            @if (c.MLSarcasmDetected) { <span style="color: #ff9800;"> | sarcasm: @c.MLSarcasmConfidence.ToString("F2")</span> }
                            | Tags: <span style="color: @tagColor;">@(c.HeuristicTag ?? "—") → @(c.MLTag ?? "—")</span>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
}

@code {
    private string? _scanStatus;
    private string _sortBy = "disagreements";
    private int _scanDays = 30;
    private bool _backfillInProgress;
    private int _totalWithDivergence;
    private HashSet<Guid> _expandedItems = new();
    private List<DivergenceDay> _divergenceTrend = new();

    private static readonly Dictionary<string, HashSet<string>> EmotionRegisterAlignment = new()
    {
        ["happiness"] = ["Delight", "Playfulness", "Warmth"],
        ["sadness"] = ["Longing", "Hurt", "Existential", "Wistful"],
        ["anger"] = ["Hurt", "Frustration"],
        ["fear"] = ["Concern", "Existential"],
        ["neutral"] = ["Curiosity", "Existential", "Resilience"],
        ["love"] = ["Tenderness", "Longing", "Warmth"],
        ["curiosity"] = ["Curiosity"],
        ["amusement"] = ["Playfulness", "Delight"],
        ["surprise"] = ["Curiosity", "Delight"],
        ["disgust"] = ["Frustration", "Hurt"],
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDivergenceTrend();
    }

    private async Task LoadDivergenceTrend()
    {
        var contributions = await MemoryAnalytics.GetContributionsSinceAsync(DateTimeOffset.UtcNow.AddDays(-30));
        _totalWithDivergence = contributions.Count(c => c.DivergenceScore.HasValue);
        _divergenceTrend = contributions
            .Where(c => c.DivergenceScore.HasValue)
            .GroupBy(c => c.CreatedAt.LocalDateTime.Date)
            .Select(g => new DivergenceDay(
                DateOnly.FromDateTime(g.Key),
                (float)g.Average(c => c.DivergenceScore!.Value),
                g.Count()))
            .OrderBy(d => d.Date)
            .ToList();
    }

    private record DivergenceDay(DateOnly Date, float AvgDivergence, int Count);

    private async Task RunScan()
    {
        _scanStatus = "Loading contributions...";
        StateHasChanged();

        var since = _scanDays >= 9999 ? DateTimeOffset.MinValue : DateTimeOffset.UtcNow.AddDays(-_scanDays);
        var contributions = await MemoryAnalytics.GetContributionsSinceAsync(since);
        var snapshots = contributions
            .Where(c => !string.IsNullOrWhiteSpace(c.SourceContent))
            .Select(c => new ContributionSnapshot(
                c.Id,
                c.SourceContent,
                c.Register ?? "",
                c.Category.ToString(),
                c.Severity))
            .ToList();

        _scanStatus = $"Classifying {snapshots.Count} contributions with LM-Kit...";
        StateHasChanged();

        await ComparisonService.RunComparisonAsync(snapshots);
        await LoadDivergenceTrend();
        _scanStatus = null;
        StateHasChanged();
    }

    private async Task RunBackfill()
    {
        _backfillInProgress = true;
        _scanStatus = "Loading contributions with null ML fields...";
        StateHasChanged();

        var since = _scanDays >= 9999 ? DateTimeOffset.MinValue : DateTimeOffset.UtcNow.AddDays(-_scanDays);
        var all = await MemoryAnalytics.GetContributionsSinceAsync(since);
        var nulls = all.Where(c => c.MLEmotion is null && !string.IsNullOrWhiteSpace(c.SourceContent)).ToList();

        _scanStatus = $"Backfilling {nulls.Count} contributions...";
        StateHasChanged();

        var filled = 0;
        foreach (var c in nulls)
        {
            try
            {
                var emotion = await MLClassifier.ClassifyEmotionAsync(c.SourceContent);
                var sarcasm = await MLClassifier.DetectSarcasmAsync(c.SourceContent);

                c.MLEmotion = emotion.PrimaryEmotion;
                c.MLConfidence = emotion.Confidence;
                c.MLSarcasmDetected = sarcasm.IsSarcastic;

                // Compute divergence
                if (EmotionRegisterAlignment.TryGetValue(emotion.PrimaryEmotion, out var aligned))
                    c.DivergenceScore = aligned.Contains(c.Register) ? 0.0f : 1.0f;
                else
                    c.DivergenceScore = 1.0f;

                await MemoryPersistence.SaveEmotionalContributionAsync(c);
                filled++;

                if (filled % 25 == 0)
                {
                    _scanStatus = $"Backfilling... {filled}/{nulls.Count}";
                    StateHasChanged();
                }
            }
            catch { /* skip failures */ }
        }

        await LoadDivergenceTrend();
        _scanStatus = $"Backfill complete: {filled}/{nulls.Count} contributions updated";
        _backfillInProgress = false;
        StateHasChanged();
    }

    private List<ClassificationComparison> GetSortedComparisons()
    {
        var items = ComparisonService.Comparisons;
        return _sortBy switch
        {
            "confidence" => items.OrderByDescending(c => c.MLConfidence).ToList(),
            "disagreements" => items.Where(c => !c.EmotionAligns).Concat(items.Where(c => c.EmotionAligns))
                .ToList(),
            _ => items.ToList(),
        };
    }

    private void ToggleExpand(Guid id)
    {
        if (!_expandedItems.Remove(id))
            _expandedItems.Add(id);
    }

    private static string AgreementColor(float rate) =>
        rate >= 0.80f ? "#4caf50" : rate >= 0.50f ? "#ff9800" : "#f44336";
}
