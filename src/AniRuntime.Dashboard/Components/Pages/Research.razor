    // === Conversation Classifier ===
    private bool _convClassifying;
    private string _convProgress = "";
    private string _convStatus = "";
    private readonly List<string> _convFiles = new();
    private ConversationStage _convCombined = new();

    // Apr 22, 2026 — ClassifyDir is configurable via AniOptions. Default falls back to
