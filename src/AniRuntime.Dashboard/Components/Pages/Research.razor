    private readonly Dictionary<string, int> _couplingMatrix = new();
    private readonly Dictionary<string, int> _registerCounts = new();
    private List<string> _expressions = new();
    private List<string> _orderedRegisters = new();

    private static string CouplingKey(string register, string expression) => $"{register}|{expression}";

    // Reclassify state
    private bool _reclassifyInProgress;
    private string _reclassifyProgress = "";
    private string _reclassifyStatus = "";

    // Ekman-collapsed data
    private readonly Dictionary<string, int> _ekmanCollapsed = new();
    private static readonly string[] _ekmanRegs = ["happiness", "sadness", "surprise"];
    private static readonly string[] _ekmanExprs = ["happiness", "sadness", "surprise", "anger"];

    private static readonly Dictionary<string, string> EkmanRegisterMap = new()
    {
        ["Tenderness"] = "happiness", ["Delight"] = "happiness", ["Playfulness"] = "happiness",
        ["Desire"] = "happiness", ["Warmth"] = "happiness",
        ["Longing"] = "sadness", ["Wistful"] = "sadness", ["Existential"] = "sadness",
        ["Hurt"] = "sadness",
        ["Curiosity"] = "surprise",
        ["Frustration"] = "anger",
    };

    private static readonly Dictionary<string, string> EkmanExpressionMap = new()
    {
        ["happiness"] = "happiness", ["love"] = "happiness", ["amusement"] = "happiness",
        ["sadness"] = "sadness",
        ["curiosity"] = "surprise", ["surprise"] = "surprise",
        ["anger"] = "anger", ["disgust"] = "anger",
        ["fear"] = "sadness",
    };

    // Statistics
    private double _cramersV;
    private double _chiSquared;
    private double _pValue;
    private int _degreesOfFreedom;
    private readonly List<UniformityTest> _uniformityTests = new();

    protected override async Task OnInitializedAsync()
    {
        await RefreshData();
        await LoadConversationResultsAsync();
    }

    private async Task RefreshData()
    {
        _loading = true;
        StateHasChanged();

        var all = await MemoryAnalytics.GetContributionsSinceAsync(DateTimeOffset.MinValue);
        var classified = all
            .Where(c => c.Register is not null && c.MLEmotion is not null)
            .ToList();

        _totalObservations = classified.Count;
        _lastUpdated = DateTimeOffset.Now;

        // Build coupling matrix
        _couplingMatrix.Clear();
        _registerCounts.Clear();
        var expressionSet = new HashSet<string>();

        foreach (var c in classified)
        {
            var key = CouplingKey(c.Register, c.MLEmotion!);
            _couplingMatrix[key] = _couplingMatrix.GetValueOrDefault(key, 0) + 1;
            _registerCounts[c.Register] = _registerCounts.GetValueOrDefault(c.Register, 0) + 1;
            expressionSet.Add(c.MLEmotion!);
        }

        _expressions = expressionSet.OrderBy(e => e).ToList();
        _orderedRegisters = _registerCounts
            .OrderByDescending(kv => kv.Value)
            .Select(kv => kv.Key)
            .ToList();

        // Compute Cramér's V on robust registers (n >= 10)
        var robustRegs = _registerCounts.Where(kv => kv.Value >= 10).Select(kv => kv.Key).ToList();
        _robustRegisters = robustRegs.Count;
        ComputeStatistics(classified, robustRegs);

        // Ekman-collapsed matrix
        _ekmanCollapsed.Clear();
        foreach (var c in classified)
        {
            if (!EkmanRegisterMap.TryGetValue(c.Register, out var ekReg)) ekReg = "other";
            if (!EkmanExpressionMap.TryGetValue(c.MLEmotion!, out var ekExpr)) ekExpr = "other";
            var key = $"{ekReg}|{ekExpr}";
            _ekmanCollapsed[key] = _ekmanCollapsed.GetValueOrDefault(key, 0) + 1;
        }

        _loading = false;
        StateHasChanged();
    }

    private async Task ReclassifyRegisters()
    {
        _reclassifyInProgress = true;
        _reclassifyStatus = "Loading all contributions...";
        StateHasChanged();

        var all = await MemoryAnalytics.GetContributionsSinceAsync(DateTimeOffset.MinValue);
        var targets = all
            .Where(c => !string.IsNullOrWhiteSpace(c.SourceContent))
            .ToList();

        _reclassifyStatus = $"Reclassifying {targets.Count} contributions through updated prompt...";
        StateHasChanged();

        var changed = 0;
        var processed = 0;
        var dummyState = new EmotionalState(); // Neutral state for scoring context

        foreach (var c in targets)
        {
            try
            {
                var prompt = PromptBuilder.BuildEmotionalShiftPrompt(
                    c.SourceContent, dummyState, 0.2f, c.Category == ImpactCategory.Ambient);
                var raw = await Ollama.ChatJsonAsync(
                    prompt.System, Array.Empty<ChatMessage>(), prompt.User);

                var (_, _, _, _, newRegister, _) = EmotionalProcessor.ParseEmotionalShift(raw);

                if (newRegister != c.Register)
                {
                    var oldRegister = c.Register;
                    c.Register = newRegister;
                    await MemoryPersistence.SaveEmotionalContributionAsync(c);
                    changed++;
                }

                processed++;
                if (processed % 10 == 0)
                {
                    _reclassifyProgress = $"{processed}/{targets.Count}";
                    _reclassifyStatus = $"Reclassifying... {processed}/{targets.Count} ({changed} changed so far)";
                    StateHasChanged();
                }
            }
            catch
            {
                processed++;
                // Skip failures — LLM timeout or parse error
            }
        }

        _reclassifyStatus = $"Reclassification complete: {changed}/{targets.Count} contributions changed register.";
        _reclassifyInProgress = false;
        _reclassifyProgress = "";
        StateHasChanged();

        // Refresh the heatmap with new data
        await RefreshData();
    }

    private void ComputeStatistics(List<EmotionalContribution> classified, List<string> robustRegisters)
    {
        var robust = classified.Where(c => robustRegisters.Contains(c.Register)).ToList();
        _robustN = robust.Count;

        if (_robustN == 0 || robustRegisters.Count < 2 || _expressions.Count < 2)
        {
            _cramersV = 0;
            _chiSquared = 0;
            _pValue = 1;
            _degreesOfFreedom = 0;
            _uniformityTests.Clear();
            return;
        }

        int r = robustRegisters.Count;
        int k = _expressions.Count;
        int n = _robustN;

        // Build observed matrix
        var observed = new int[r, k];
        for (int i = 0; i < r; i++)
            for (int j = 0; j < k; j++)
                observed[i, j] = _couplingMatrix.GetValueOrDefault(CouplingKey(robustRegisters[i], _expressions[j]), 0);

        // Row and column totals
        var rowTotals = new int[r];
        var colTotals = new int[k];
        for (int i = 0; i < r; i++)
            for (int j = 0; j < k; j++)
            {
                rowTotals[i] += observed[i, j];
                colTotals[j] += observed[i, j];
            }

        // Chi-squared
        double chi2 = 0;
        for (int i = 0; i < r; i++)
            for (int j = 0; j < k; j++)
            {
                double expected = (double)rowTotals[i] * colTotals[j] / n;
                if (expected > 0)
                    chi2 += Math.Pow(observed[i, j] - expected, 2) / expected;
            }

        _chiSquared = chi2;
        _degreesOfFreedom = (r - 1) * (k - 1);
        int minDim = Math.Min(r, k) - 1;
        _cramersV = Math.Sqrt(chi2 / (n * minDim));

        // p-value approximation using chi-squared survival function
        _pValue = ChiSquaredSurvival(_chiSquared, _degreesOfFreedom);

        // Per-register uniformity tests
        _uniformityTests.Clear();
        foreach (var reg in robustRegisters)
        {
            var row = new int[k];
            for (int j = 0; j < k; j++)
                row[j] = _couplingMatrix.GetValueOrDefault(CouplingKey(reg, _expressions[j]), 0);

            int rowTotal = row.Sum();
            double uniformExpected = (double)rowTotal / k;
            double rowChi2 = 0;
            for (int j = 0; j < k; j++)
                rowChi2 += Math.Pow(row[j] - uniformExpected, 2) / uniformExpected;

            double rowP = ChiSquaredSurvival(rowChi2, k - 1);
            _uniformityTests.Add(new UniformityTest(reg, rowChi2, rowP));
        }
    }

    /// <summary>
    /// Approximate chi-squared survival function (upper tail probability).
    /// Uses the regularized incomplete gamma function approximation.
    /// </summary>
    private static double ChiSquaredSurvival(double x, int df)
    {
        if (x <= 0 || df <= 0) return 1.0;

        // For large chi-squared values, p is very small
        double k = df / 2.0;
        double xHalf = x / 2.0;

        // Use series expansion of the regularized lower incomplete gamma function
        // P(a, x) = gamma(a, x) / Gamma(a)
        // Then survival = 1 - P(k, x/2)

        // For reasonable accuracy, use the series:
        // P(a, x) = e^(-x) * x^a * sum(x^n / Gamma(a+n+1), n=0..inf)
        double sum = 0;
        double term = 1.0 / k;
        sum = term;
        for (int n = 1; n < 200; n++)
        {
            term *= xHalf / (k + n);
            sum += term;
            if (term < 1e-15 * sum) break;
        }

        double logP = -xHalf + k * Math.Log(xHalf) - LogGamma(k) + Math.Log(sum);
        double p = Math.Exp(logP);
        return Math.Max(0, Math.Min(1, 1.0 - p));
    }

    /// <summary>
    /// Stirling's approximation for log(Gamma(x)).
    /// </summary>
    private static double LogGamma(double x)
    {
        if (x <= 0) return 0;
        // Lanczos approximation
        double[] c = { 76.18009172947146, -86.50532032941677, 24.01409824083091,
                       -1.231739572450155, 0.001208650973866179, -0.000005395239384953 };
        double sum = 1.000000000190015;
        double y = x;
        for (int i = 0; i < 6; i++)
            sum += c[i] / ++y;
        return (x + 0.5) * Math.Log(x + 5.5) - (x + 5.5) + Math.Log(2.5066282746310005 * sum / x);
    }

