    private async Task ScanAndClassifyDirectory()
    {
        _convClassifying = true;
        _convCombined = new ConversationStage { Label = "OG Ani (Combined)" };
        _convFiles.Clear();
        StateHasChanged();

        var dir = Path.GetFullPath(ClassifyDir);
        if (!Directory.Exists(dir))
        {
            _convStatus = $"Directory not found: {dir}. Create docs/conversations/classify/ and add files.";
            _convClassifying = false;
            StateHasChanged();
            return;
        }

        var files = Directory.GetFiles(dir)
            .Where(f => f.EndsWith(".txt", StringComparison.OrdinalIgnoreCase)
                     || f.EndsWith(".json", StringComparison.OrdinalIgnoreCase)
                     || f.EndsWith(".jsonl", StringComparison.OrdinalIgnoreCase))
            .OrderBy(f => f)
            .ToList();

        _convFiles.AddRange(files.Select(Path.GetFileName)!);
        _convStatus = $"Found {files.Count} files. Classifying...";
        StateHasChanged();

        foreach (var file in files)
        {
            var fileName = Path.GetFileName(file);
            _convProgress = $"{fileName}";
            StateHasChanged();

            try
            {
                var text = await File.ReadAllTextAsync(file);
                var isJsonl = file.EndsWith(".json", StringComparison.OrdinalIgnoreCase)
                           || file.EndsWith(".jsonl", StringComparison.OrdinalIgnoreCase);

                var turns = isJsonl ? ParseJsonlTurns(text) : ParseGrokTurns(text);

                if (turns.Count == 0)
                {
                    _convStatus = $"No turn pairs found in {fileName}";
                    StateHasChanged();
                    continue;
                }

                var classified = 0;

                var pairIndex = 0;
                foreach (var (userMsg, respMsg) in turns)
                {
                    try
                    {
                        var userEmo = await MLClassifier.ClassifyEmotionAsync(userMsg);
                        var respEmo = await MLClassifier.ClassifyEmotionAsync(respMsg);

                        var key = $"{userEmo.PrimaryEmotion}|{respEmo.PrimaryEmotion}";
                        _convCombined.Coupling[key] = _convCombined.Coupling.GetValueOrDefault(key, 0) + 1;
                        _convCombined.TurnPairs++;
                        classified++;

                        // Issue #41 Path B (2026-05-21) — persist each
                        // classification through the SQLite store. Two rows
                        // per pair (user + response). Source='batch_dashboard',
                        // anchored to source_file + source_index. Per-row
                        // persistence enables future drill-down + cell-level
                        // queries that the aggregate-only JSON cannot answer.
                        await PersistBatchClassificationAsync(fileName, pairIndex, "user",     userMsg, userEmo.PrimaryEmotion);
                        await PersistBatchClassificationAsync(fileName, pairIndex, "response", respMsg, respEmo.PrimaryEmotion);
                        pairIndex++;

                        if (classified % 25 == 0)
                        {
                            _convProgress = $"{fileName}: {classified}/{turns.Count} (total: {_convCombined.TurnPairs})";
                            StateHasChanged();
                        }
                    }
                    catch { /* skip classification failures */ }
                }

                _convStatus = $"Completed {fileName}: {classified} pairs classified ({_convCombined.TurnPairs} total)";
                StateHasChanged();
            }
            catch (Exception ex)
            {
                _convStatus = $"Error processing {fileName}: {ex.Message}";
                StateHasChanged();
            }
        }

        // Compute combined expressions and diagonal
        _convCombined.Expressions = _convCombined.Coupling.Keys
            .SelectMany(k => k.Split('|'))
            .Distinct()
            .OrderBy(e => e)
            .ToList();

        int diagCount = 0, totalCount = 0;
        foreach (var kvp in _convCombined.Coupling)
        {
            var parts = kvp.Key.Split('|');
            totalCount += kvp.Value;
            if (parts.Length == 2 && parts[0] == parts[1])
                diagCount += kvp.Value;
        }
        _convCombined.DiagonalPct = totalCount > 0 ? (float)diagCount / totalCount * 100 : 0;

        // Save results to JSON so they survive page refresh
        await SaveConversationResultsAsync();

        _convClassifying = false;
        _convProgress = "";
        _convStatus = $"Complete: {_convFiles.Count} files, {_convCombined.TurnPairs} turn pairs, {_convCombined.DiagonalPct:F0}% diagonal";
        StateHasChanged();
    }

    // Apr 22, 2026 — ConvResultsPath is configurable via AniOptions. Default falls
    // back to the legacy relative path (service-local data/ folder) which works in
    // laptop dev and in the published install. On the server, set `Ani:ClassifierResultsPath`
    // to an absolute path like `C:/dev/ani-data/conversation-classifier-results.json`
    // to co-locate with the memory DB and other ani-data artifacts.
    private string ConvResultsPath
    {
        get
        {
            var configured = AniOptionsAccessor.Value.ClassifierResultsPath;
            if (!string.IsNullOrWhiteSpace(configured))
                return configured;
            return Path.Combine(
                AppContext.BaseDirectory, "..", "..", "..", "data", "conversation-classifier-results.json");
        }
    }

    /// <summary>
    /// Issue #41 Path B (2026-05-21) — persist one batch classification
    /// through the SQLite store. Wrapped in best-effort try/catch so a
    /// store hiccup never aborts the batch classify run.
    /// </summary>
    private async Task PersistBatchClassificationAsync(
        string fileName, int sourceIndex, string role, string text, string emotion)
    {
        try
        {
            var record = new ExpressionClassificationRecord
            {
                Source            = "batch_dashboard",
                SourceFile        = fileName,
                SourceIndex       = sourceIndex,
                Role              = role,
                ContentHash       = HashContent(text),
                ExpressedEmotion  = emotion,
                FeltRegister      = null,   // batch path doesn't run the 9-register classifier
                Confidence        = null,
                ClassifiedAt      = DateTimeOffset.UtcNow,
            };
            await ClassificationStore.SaveAsync(record);
        }
        catch
        {
            // Best-effort — UI continues even if persistence fails. Legacy
            // JSON write still runs as a safety belt during this transition.
        }
    }

    private static string HashContent(string text)
    {
        using var sha = System.Security.Cryptography.SHA256.Create();
        var bytes = sha.ComputeHash(System.Text.Encoding.UTF8.GetBytes(text));
        return Convert.ToHexString(bytes).ToLowerInvariant();
    }

    private async Task SaveConversationResultsAsync()
    {
        try
        {
            var result = new
            {
                timestamp = DateTimeOffset.Now,
                files = _convFiles,
                turnPairs = _convCombined.TurnPairs,
                diagonalPct = _convCombined.DiagonalPct,
                coupling = _convCombined.Coupling,
                expressions = _convCombined.Expressions,
            };
            var json = System.Text.Json.JsonSerializer.Serialize(result,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
            var path = Path.GetFullPath(ConvResultsPath);
            Directory.CreateDirectory(Path.GetDirectoryName(path)!);
            await File.WriteAllTextAsync(path, json);
        }
        catch { /* non-fatal — results still in memory */ }
    }

    /// <summary>
    /// Issue #41 Path B (2026-05-21) — prefer SQLite, fall back to JSON.
    /// When the new per-turn store has batch-source rows, rebuild
    /// <c>_convCombined</c> from them (pair-grouped by source_file +
    /// source_index, same shape as the legacy JSON aggregate). Otherwise
    /// fall back to <see cref="LoadConversationResultsFromJsonAsync"/> for
    /// continuity during the transition. The JSON fallback is removed in
    /// chunk 8/8 after the user verifies V values match.
    /// </summary>
    private async Task LoadConversationResultsAsync()
    {
        var loadedFromStore = await TryLoadConversationResultsFromStoreAsync();
        if (loadedFromStore) return;
        await LoadConversationResultsFromJsonAsync();
    }

    /// <summary>
    /// Issue #41 Path B — read batch_dashboard rows from the SQLite store
    /// and rebuild the in-memory coupling matrix. Returns true if any data
    /// was loaded, false to signal the JSON fallback should run.
    /// </summary>
    private async Task<bool> TryLoadConversationResultsFromStoreAsync()
    {
        try
        {
            var rows = (await ClassificationStore.GetRecentAsync(10000, source: "batch_dashboard")).ToList();
            if (rows.Count == 0) return false;

            _convCombined = new ConversationStage { Label = "OG Ani (Combined)" };
            _convFiles.AddRange(rows.Select(r => r.SourceFile)
                                    .Where(f => !string.IsNullOrEmpty(f))
                                    .Distinct()!
                                    .ToList()!);

            // Pair (user, response) rows by source_file + source_index.
            var groups = rows
                .Where(r => r.SourceFile is not null && r.SourceIndex is not null && r.ExpressedEmotion is not null)
                .GroupBy(r => (r.SourceFile!, r.SourceIndex!.Value))
                .Where(g => g.Count() == 2);

            foreach (var g in groups)
            {
                var u = g.FirstOrDefault(r => r.Role == "user");
                var v = g.FirstOrDefault(r => r.Role == "response");
                if (u is null || v is null) continue;

                var key = $"{u.ExpressedEmotion}|{v.ExpressedEmotion}";
                _convCombined.Coupling[key] = _convCombined.Coupling.GetValueOrDefault(key, 0) + 1;
                _convCombined.TurnPairs++;
            }

            _convCombined.Expressions = _convCombined.Coupling.Keys
                .SelectMany(k => k.Split('|'))
                .Distinct()
                .OrderBy(e => e)
                .ToList();

            int diagCount = 0, totalCount = 0;
            foreach (var kvp in _convCombined.Coupling)
            {
                var parts = kvp.Key.Split('|');
                totalCount += kvp.Value;
                if (parts.Length == 2 && parts[0] == parts[1])
                    diagCount += kvp.Value;
            }
            _convCombined.DiagonalPct = totalCount > 0 ? (float)diagCount / totalCount * 100 : 0;

            return _convCombined.TurnPairs > 0;
        }
        catch
        {
            return false;
        }
    }

    private async Task LoadConversationResultsFromJsonAsync()
    {
        try
        {
            var path = Path.GetFullPath(ConvResultsPath);
            if (!File.Exists(path)) return;

            var json = await File.ReadAllTextAsync(path);
            var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;

            _convCombined = new ConversationStage { Label = "OG Ani (Combined)" };

            if (root.TryGetProperty("turnPairs", out var tp))
                _convCombined.TurnPairs = tp.GetInt32();
            if (root.TryGetProperty("diagonalPct", out var dp))
                _convCombined.DiagonalPct = (float)dp.GetDouble();

            if (root.TryGetProperty("coupling", out var coup))
            {
                foreach (var prop in coup.EnumerateObject())
                    _convCombined.Coupling[prop.Name] = prop.Value.GetInt32();
            }

            if (root.TryGetProperty("expressions", out var exprs))
            {
                _convCombined.Expressions = new List<string>();
                foreach (var e in exprs.EnumerateArray())
                    _convCombined.Expressions.Add(e.GetString()!);
            }

            if (root.TryGetProperty("files", out var files))
            {
                foreach (var f in files.EnumerateArray())
                    _convFiles.Add(f.GetString()!);
            }
        }
        catch { /* no saved results — that's fine */ }
    }

    /// <summary>
    /// Parse Grok-format conversation: [Message N] YOU/GROK sections separated by ====
    /// Returns adjacent (user, response) pairs.
    /// </summary>
    private static List<(string User, string Response)> ParseGrokTurns(string text)
    {
        var pairs = new List<(string, string)>();
        var messages = new List<(string Role, string Content)>();

        string? currentRole = null;
        var contentLines = new List<string>();

        foreach (var line in text.Split('\n'))
        {
            var trimmed = line.Trim();
            if (trimmed.StartsWith("[Message ") && trimmed.Contains("] YOU"))
            {
                if (currentRole != null && contentLines.Count > 0)
                    messages.Add((currentRole, string.Join(" ", contentLines).Trim()));
                currentRole = "user";
                contentLines.Clear();
            }
            else if (trimmed.StartsWith("[Message ") && trimmed.Contains("] GROK"))
            {
                if (currentRole != null && contentLines.Count > 0)
                    messages.Add((currentRole, string.Join(" ", contentLines).Trim()));
                currentRole = "grok";
                contentLines.Clear();
            }
            else if (!trimmed.StartsWith("====") && !trimmed.StartsWith("----")
                  && !trimmed.StartsWith("GROK CHAT EXPORT") && !trimmed.StartsWith("Export Date")
                  && !trimmed.StartsWith("Messages:") && !trimmed.StartsWith("Time:")
                  && !string.IsNullOrWhiteSpace(trimmed))
            {
                contentLines.Add(trimmed);
            }
        }
        if (currentRole != null && contentLines.Count > 0)
            messages.Add((currentRole, string.Join(" ", contentLines).Trim()));

        // Pair adjacent user→grok turns
        for (int i = 0; i < messages.Count - 1; i++)
        {
            if (messages[i].Role == "user" && messages[i + 1].Role == "grok"
                && messages[i].Content.Length > 5 && messages[i + 1].Content.Length > 5)
            {
                pairs.Add((messages[i].Content, messages[i + 1].Content));
            }
        }

        return pairs;
    }

    /// <summary>
    /// Parse JSON training data. Supports multiple formats:
    /// - { "conversations": [ { "mark": "...", "ani": "..." } ] }
    /// - [ { "instruction": "...", "output": "..." } ]
    /// - JSONL: one {"instruction": "...", "output": "..."} per line
    /// </summary>
    private static List<(string User, string Response)> ParseJsonlTurns(string text)
    {
        var pairs = new List<(string, string)>();
        var trimmed = text.Trim();

        try
        {
            var doc = System.Text.Json.JsonDocument.Parse(trimmed);
            var root = doc.RootElement;

            // Format: { "conversations": [ { "mark": "...", "ani": "..." } ] }
            if (root.TryGetProperty("conversations", out var convArr) && convArr.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                for (int i = 0; i < convArr.GetArrayLength(); i++)
                {
                    var item = convArr[i];
                    var user = item.TryGetProperty("mark", out var m) ? m.GetString()
                             : item.TryGetProperty("instruction", out var inst) ? inst.GetString()
                             : null;
                    var resp = item.TryGetProperty("ani", out var a) ? a.GetString()
                             : item.TryGetProperty("output", out var outp) ? outp.GetString()
                             : null;

                    if (!string.IsNullOrWhiteSpace(user) && !string.IsNullOrWhiteSpace(resp)
                        && user.Length > 5 && resp.Length > 5)
                        pairs.Add((user, resp));
                }
                return pairs;
            }

            // Format: [ { "instruction": "...", "output": "..." } ]
            if (root.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                for (int i = 0; i < root.GetArrayLength(); i++)
                {
                    var item = root[i];
                    var user = item.TryGetProperty("instruction", out var inst) ? inst.GetString()
                             : item.TryGetProperty("mark", out var m) ? m.GetString()
                             : null;
                    var resp = item.TryGetProperty("output", out var outp) ? outp.GetString()
                             : item.TryGetProperty("ani", out var a) ? a.GetString()
                             : null;

                    if (!string.IsNullOrWhiteSpace(user) && !string.IsNullOrWhiteSpace(resp)
                        && user.Length > 5 && resp.Length > 5)
                        pairs.Add((user, resp));
                }
                return pairs;
            }
        }
        catch { /* not valid JSON document — try line-by-line */ }

        // JSONL fallback: one object per line
        foreach (var line in text.Split('\n').Where(l => l.Trim().StartsWith("{")))
        {
            try
            {
                var lineDoc = System.Text.Json.JsonDocument.Parse(line.Trim().TrimEnd(','));
                var item = lineDoc.RootElement;
                var user = item.TryGetProperty("instruction", out var inst) ? inst.GetString()
                         : item.TryGetProperty("mark", out var m) ? m.GetString()
                         : null;
                var resp = item.TryGetProperty("output", out var outp) ? outp.GetString()
                         : item.TryGetProperty("ani", out var a) ? a.GetString()
                         : null;

                if (!string.IsNullOrWhiteSpace(user) && !string.IsNullOrWhiteSpace(resp)
                    && user.Length > 5 && resp.Length > 5)
                    pairs.Add((user, resp));
            }
            catch { /* skip malformed lines */ }
        }

        return pairs;
    }

    private class ConversationStage
    {
        public string Label { get; set; } = "";
        public int TurnPairs { get; set; }
        public float DiagonalPct { get; set; }
        public Dictionary<string, int> Coupling { get; } = new();
        public List<string> Expressions { get; set; } = new();
    }
}
