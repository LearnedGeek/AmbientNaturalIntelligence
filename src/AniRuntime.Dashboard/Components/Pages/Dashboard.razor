@page "/"
@using AniRuntime.Core.Interfaces
@using AniRuntime.Core.Models
@inject IStateStore StateStore
@inject IMemorySearch MemorySearch
@inject IMemoryAnalytics MemoryAnalytics
@inject IMemoryPersistence MemoryPersist
@inject IMemoryMaintenance MemoryMaintenance
@inject IConversationService Conversations
@inject IDiagnosticService DiagnosticService
@using AniRuntime.Core
@using AniRuntime.Loops

<h1>ANI Dashboard</h1>

@if (_diagnosticReport is not null)
{
    var badgeColor = _diagnosticReport.OverallSeverity switch
    {
        DiagnosticSeverity.Healthy => "#4caf50",
        DiagnosticSeverity.Info => "#2196f3",
        DiagnosticSeverity.Warning => "#ff9800",
        DiagnosticSeverity.Critical => "#f44336",
        _ => "#607d8b",
    };
    var badgeIcon = _diagnosticReport.OverallSeverity switch
    {
        DiagnosticSeverity.Healthy => "OK",
        DiagnosticSeverity.Info => "i",
        DiagnosticSeverity.Warning => "!",
        DiagnosticSeverity.Critical => "!!",
        _ => "?",
    };
    <section style="margin-bottom: 1rem;">
        <div style="display: flex; align-items: center; gap: 0.75rem;">
            <div style="background: @badgeColor; color: white; width: 2.5rem; height: 2.5rem; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 0.9rem;">@badgeIcon</div>
            <div>
                <strong>System Health: @_diagnosticReport.OverallSeverity</strong>
                <br />
                <small style="opacity: 0.6;">@_diagnosticReport.LinesScanned lines scanned, @(_diagnosticReport.WindowScanned.TotalMinutes.ToString("F0")) min window — @_diagnosticReport.Timestamp.LocalDateTime.ToString("h:mm tt")</small>
            </div>
            <button @onclick="RunDiagnostic" style="margin-left: auto; padding: 0.3em 0.8em; border-radius: 4px; background: rgba(255,255,255,0.1); color: inherit; border: none; cursor: pointer;">Run Now</button>
        </div>
        @if (_diagnosticReport.Findings.Count > 0)
        {
            <div style="margin-top: 0.5rem;">
                @foreach (var finding in _diagnosticReport.Findings)
                {
                    var fColor = finding.Severity switch
                    {
                        DiagnosticSeverity.Warning => "#ff9800",
                        DiagnosticSeverity.Critical => "#f44336",
                        DiagnosticSeverity.Info => "#2196f3",
                        _ => "#607d8b",
                    };
                    <div style="border-left: 3px solid @fColor; padding: 0.3em 0.6em; margin-top: 0.3rem; font-size: 0.85em;">
                        <strong style="color: @fColor;">[@finding.Code]</strong> @finding.Description
                        @if (finding.SuggestedAction is not null)
                        {
                            <br /><small style="opacity: 0.6;">Suggestion: @finding.SuggestedAction</small>
                        }
                    </div>
                }
            </div>
        }
    </section>
}

<section>
    <hgroup>
        <h2>@_charState?.Name</h2>
        <p>Persona v@(_charState?.PersonaVersion) | Contact: @_charState?.PrimaryContactName</p>
    </hgroup>
</section>

@if (_emotional is not null)
{
    <section>
        <h3>Emotional State</h3>
        <small style="opacity: 0.6;">Current emotional dimensions (0.0–1.0). Click any card to see which thoughts are driving that value.
        These are computed from active emotional contributions — each thought shifts the state, then decays over time.</small>
        <div class="grid">
            <EmotionalStateCard Label="Warmth" Value="@_emotional.Warmth"
                IsSelected="@(_selectedDimension == "Warmth")" OnClick="@(() => ToggleDimension("Warmth"))" />
            <EmotionalStateCard Label="Energy" Value="@_emotional.Energy"
                IsSelected="@(_selectedDimension == "Energy")" OnClick="@(() => ToggleDimension("Energy"))" />
            <EmotionalStateCard Label="Worry" Value="@_emotional.Worry"
                IsSelected="@(_selectedDimension == "Worry")" OnClick="@(() => ToggleDimension("Worry"))" />
            <EmotionalStateCard Label="Playfulness" Value="@_emotional.Playfulness"
                IsSelected="@(_selectedDimension == "Playfulness")" OnClick="@(() => ToggleDimension("Playfulness"))" />
        </div>
        @if (!string.IsNullOrEmpty(_emotional.Describe()))
        {
            <p><em>@_emotional.Describe()</em></p>
        }
    </section>

    @if (_selectedDimension is not null)
    {
        var filtered = GetContributionsForDimension(_selectedDimension);
        var dimensionColor = _selectedDimension switch
        {
            "Warmth" => "#4caf50",
            "Energy" => "#2196f3",
            "Worry" => "#ff9800",
            "Playfulness" => "#9c27b0",
            _ => "#607d8b",
        };
        <section>
            <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
                <h3 style="margin: 0; color: @dimensionColor;">@_selectedDimension Contributors</h3>
                <small style="opacity: 0.6;">@filtered.Count active</small>
                <div style="margin-left: auto; display: flex; gap: 0.3rem;">
                    <button @onclick="@(() => SetSort("score"))"
                            style="padding: 0.2em 0.5em; border-radius: 4px; background: @(_contributionSort == "score" ? "rgba(255,255,255,0.2)" : "rgba(255,255,255,0.05)"); color: inherit; border: none; cursor: pointer; font-size: 0.8em;">Score</button>
                    <button @onclick="@(() => SetSort("severity"))"
                            style="padding: 0.2em 0.5em; border-radius: 4px; background: @(_contributionSort == "severity" ? "rgba(255,255,255,0.2)" : "rgba(255,255,255,0.05)"); color: inherit; border: none; cursor: pointer; font-size: 0.8em;">Sev</button>
                    <button @onclick="@(() => SetSort("decay"))"
                            style="padding: 0.2em 0.5em; border-radius: 4px; background: @(_contributionSort == "decay" ? "rgba(255,255,255,0.2)" : "rgba(255,255,255,0.05)"); color: inherit; border: none; cursor: pointer; font-size: 0.8em;">Decay</button>
                    <button @onclick="@(() => ToggleDimension(_selectedDimension))"
                            style="padding: 0.2em 0.6em; border-radius: 4px; background: rgba(255,255,255,0.1); color: inherit; border: none; cursor: pointer; font-size: 0.8em;">✕</button>
                </div>
            </div>
            @if (filtered.Count == 0)
            {
                <p style="opacity: 0.5;"><em>No active contributions affecting @_selectedDimension</em></p>
            }
            else
            {
                @foreach (var c in filtered)
                {
                    var delta = GetDelta(c, _selectedDimension);
                    var decay = c.DecayFactor(DateTimeOffset.UtcNow);
                    var effective = delta * c.Severity * (float)decay;
                    var age = DateTimeOffset.UtcNow - c.CreatedAt;
                    var ageStr = age.TotalHours < 1 ? $"{age.TotalMinutes:F0}m ago" : $"{age.TotalHours:F1}h ago";
                    var isExpanded = _expandedContributions.Contains(c.Id);
                    <div style="border-left: 3px solid @dimensionColor; padding: 0.4em 0.8em; margin-bottom: 0.4rem; background: rgba(255,255,255,0.03);">
                        <div style="display: flex; justify-content: space-between; align-items: baseline; cursor: pointer;"
                             @onclick="() => ToggleExpand(c.Id)">
                            <span style="font-size: 0.9em; @(isExpanded ? "" : "overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 70%;")">@(string.IsNullOrEmpty(c.SourceContent) ? "(no source)" : c.SourceContent)</span>
                            <span style="font-size: 0.8em; white-space: nowrap; margin-left: 1em;">
                                <span style="color: @HeatColor(effective); font-weight: bold;">@FormatDelta(effective)</span>
                                <span style="opacity: 0.5;"> (raw @FormatDelta(delta))</span>
                            </span>
                        </div>
                        <div style="font-size: 0.75em; opacity: 0.5; margin-top: 0.2em;">
                            @c.Category | @(string.IsNullOrEmpty(c.Register) ? "—" : c.Register) |
                            sev: <span style="color: @HeatColor(c.Severity);">@c.Severity.ToString("F2")</span> |
                            decay: <span style="color: @HeatColor((float)decay);">@decay.ToString("F2")</span> | @ageStr
                            <button style="margin-left: 0.5em; font-size: 0.9em; padding: 0 0.3em; cursor: pointer;"
                                    @onclick="() => ExpireContribution(c.Id)"
                                    title="Expire this contribution">✕</button>
                        </div>
                    </div>
                }
            }
        </section>
    }
}

@if (_desire is not null && _emotional is not null)
{
    var emotionMod = DesireEngine.ComputeEmotionDesireModifier(_emotional);
    <section>
        <h3>Desire State</h3>
        <div class="grid">
            <article>
                <header>Desire to Connect</header>
                <div style="text-align: center;">
                    <p style="font-size: 2em; margin: 0;">@_desire.DesireToConnect.ToString("F2")</p>
                    <progress value="@_desire.DesireToConnect" max="1" style="width: 80%;"></progress>
                </div>
            </article>
            <article>
                <header>Emotion Modifier</header>
                <div style="text-align: center;">
                    <p style="font-size: 2em; margin: 0; color: @(emotionMod > 1.05f ? "#4caf50" : emotionMod < 0.95f ? "#f44336" : "#888")">@emotionMod.ToString("F2")x</p>
                    <small style="opacity: 0.6;">@(emotionMod > 1.05f ? "accelerating" : emotionMod < 0.95f ? "suppressing" : "neutral")</small>
                </div>
            </article>
            <article>
                <header>Cooldown</header>
                <div style="text-align: center;">
                    @if (_desire.CooldownActive && _desire.CooldownUntil > DateTimeOffset.UtcNow)
                    {
                        var remaining = _desire.CooldownUntil - DateTimeOffset.UtcNow;
                        <p style="font-size: 1.2em; margin: 0; color: #ff9800;">@remaining.TotalMinutes.ToString("F0")m remaining</p>
                    }
                    else
                    {
                        <p style="font-size: 1.2em; margin: 0; color: #4caf50;">Ready</p>
                    }
                </div>
            </article>
            <article>
                <header>Circadian</header>
                <div style="text-align: center;">
                    <p style="font-size: 2em; margin: 0;">@_desire.CircadianModifier.ToString("F2")</p>
                    <small style="opacity: 0.6;">@(DateTimeOffset.Now.Hour switch { >= 6 and < 10 => "morning", >= 10 and < 17 => "afternoon", >= 17 and < 21 => "evening", _ => "night" })</small>
                </div>
            </article>
        </div>
    </section>
}

@if (_allContributions.Count > 0)
{
    <section>
        <h3>Register Distribution</h3>
        <small style="opacity: 0.6;">Which emotional registers Ani's thoughts have been scored into over the last 30 days.
        Growth Readiness measures how many registers are above 5% — a balanced distribution means the model
        is ready for v7 training. Heavily skewed = echo chamber (needs more diverse thinking).</small>
        <RegisterHeatmap Contributions="@_allContributions" WindowDays="30" />
    </section>

    @if (_registerTrend.Count > 1)
    {
        <section>
            <h3>Register Diversity Trend</h3>
            <small style="opacity: 0.6;">How many different emotional registers appear each day (max 10).
            Green = 7+ registers (highly diverse), orange = 4-6, red = 1-3 (echo chamber).
            This trend shows whether the Inner Thought Reform is producing varied content over time.</small>
            <div style="display: flex; align-items: flex-end; gap: 2px; height: 100px; margin-top: 0.5rem; padding: 0.5rem 0;">
                @foreach (var day in _registerTrend)
                {
                    var barHeight = Math.Max(day.UniqueRegisters * 10, 2);
                    var barColor = day.UniqueRegisters >= 7 ? "#4caf50" : day.UniqueRegisters >= 4 ? "#ff9800" : "#f44336";
                    <div style="display: flex; flex-direction: column; align-items: center; flex: 1; min-width: 20px;">
                        <small style="font-size: 0.6em; opacity: 0.5; margin-bottom: 2px;">@day.UniqueRegisters</small>
                        <div style="width: 100%; max-width: 40px; height: @(barHeight)px; background: @barColor; border-radius: 2px 2px 0 0;"
                             title="@day.Date.ToString("MMM d"): @day.UniqueRegisters registers, @day.Total contributions"></div>
                        <small style="font-size: 0.6em; opacity: 0.4; margin-top: 2px;">@day.Date.ToString("M/d")</small>
                    </div>
                }
            </div>
        </section>
    }
}

@if (_recentThoughts.Count > 0)
{
    <section>
        <h3>Recent Inner Thoughts</h3>
        @foreach (var thought in _recentThoughts.Take(5))
        {
            var contribution = FindContributionForThought(thought);
            <blockquote>
                <p>@thought.Content</p>
                <footer>
                    @thought.CreatedAt.LocalDateTime.ToString("MMM d, h:mm tt")
                    @if (contribution is not null)
                    {
                        var decay = contribution.DecayFactor(DateTimeOffset.UtcNow);
                        <span style="margin-left: 1em; font-size: 0.85em;">
                            <span style="color: @DeltaColor(contribution.WarmthDelta)">W:@FormatDelta(contribution.WarmthDelta)</span>
                            <span style="color: @DeltaColor(contribution.EnergyDelta)">E:@FormatDelta(contribution.EnergyDelta)</span>
                            <span style="color: @DeltaColor(contribution.WorryDelta)">C:@FormatDelta(contribution.WorryDelta)</span>
                            <span style="color: @DeltaColor(contribution.PlayfulnessDelta)">P:@FormatDelta(contribution.PlayfulnessDelta)</span>
                            <span style="color: #888"> decay:@decay.ToString("F2")</span>
                        <span style="color: #888"> sev:@contribution.Severity.ToString("F2")</span>
                        <button style="margin-left: 0.5em; font-size: 0.75em; padding: 0 0.3em; cursor: pointer;"
                                @onclick="() => ExpireContribution(contribution.Id)"
                                title="Expire this contribution">✕</button>
                        </span>
                    }
                </footer>
            </blockquote>
        }
    </section>
}

@{
    var driftChain = _contributions
        .Where(c => c.AssociativeAnchor is not null)
        .OrderByDescending(c => c.CreatedAt)
        .Take(20)
        .Reverse()
        .ToList();
}
@if (driftChain.Count > 1)
{
    <section>
        <h3>Associative Drift</h3>
        <small style="opacity: 0.6;">How thoughts chain together — each anchor seeds the next thought.
        Click to expand the full thought. Arrows show the creative drift path.</small>

        <div style="margin-top: 0.5rem;">
            @for (var i = 0; i < driftChain.Count; i++)
            {
                var c = driftChain[i];
                var isExpanded = _expandedDrift.Contains(c.Id);
                var anchorColor = c.MLEmotion switch
                {
                    "sadness" => "#2196f3",
                    "happiness" => "#4caf50",
                    "love" => "#e91e63",
                    "curiosity" => "#ff9800",
                    "amusement" => "#9c27b0",
                    "anger" => "#f44336",
                    "fear" => "#ff5722",
                    _ => "#607d8b",
                };
                var isWorld = c.SourceContent.Contains("bookstore") || c.SourceContent.Contains("shift") || c.SourceContent.Contains("shelf");
                <div style="display: flex; align-items: flex-start; gap: 0.5rem; margin-bottom: 0.3rem;">
                    @* Anchor badge *@
                    <div style="min-width: 110px; text-align: right;">
                        <span style="background: @(anchorColor)30; color: @anchorColor; padding: 0.2em 0.5em; border-radius: 4px; font-size: 0.85em; font-weight: bold; cursor: pointer;"
                              @onclick="() => ToggleDrift(c.Id)"
                              title="@c.CreatedAt.LocalDateTime.ToString("h:mm tt")">
                            @c.AssociativeAnchor
                        </span>
                        @if (isWorld)
                        {
                            <small style="display: block; font-size: 0.6em; opacity: 0.5; margin-top: 1px;">world</small>
                        }
                    </div>

                    @* Arrow *@
                    @if (i < driftChain.Count - 1)
                    {
                        <span style="color: rgba(255,255,255,0.3); font-size: 0.8em; margin-top: 0.2em;">→</span>
                    }

                    @* Expandable thought *@
                    @if (isExpanded)
                    {
                        <div style="flex: 1; font-size: 0.8em; opacity: 0.8; border-left: 2px solid @(anchorColor)40; padding-left: 0.5em;">
                            <div>@c.SourceContent</div>
                            <small style="opacity: 0.5;">@c.Register | @(c.MLEmotion ?? "—") (@(c.MLConfidence?.ToString("F2") ?? "—")) | @c.CreatedAt.LocalDateTime.ToString("h:mm tt")</small>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
}

@if (_activeThread is not null)
{
    <section>
        <h3>Active Conversation</h3>
        @foreach (var msg in _activeThread.Messages.TakeLast(6))
        {
            <p><strong>@msg.Role:</strong> @msg.Content <small>@msg.SentAt.LocalDateTime.ToString("h:mm tt")</small></p>
        }
    </section>
}

@code {
    private CharacterStateDoc? _charState;
    private EmotionalState? _emotional;
    private DesireState? _desire;
    private List<MemoryRecord> _recentThoughts = new();
    private List<EmotionalContribution> _contributions = new();
    private List<EmotionalContribution> _allContributions = new();
    private ConversationThread? _activeThread;
    private DiagnosticReport? _diagnosticReport;
    private string? _selectedDimension;
    private string _contributionSort = "score";
    private HashSet<Guid> _expandedContributions = new();
    private HashSet<Guid> _expandedDrift = new();
    private List<(DateOnly Date, int UniqueRegisters, int Total)> _registerTrend = new();

    protected override async Task OnInitializedAsync()
    {
        _charState = await StateStore.GetCharacterStateAsync();
        _emotional = await StateStore.GetEmotionalStateAsync();
        _desire = await StateStore.GetDesireStateAsync();
        _recentThoughts = (await MemorySearch.GetByTypeAsync(MemoryType.InnerThought, 5)).ToList();
        _contributions = await MemoryAnalytics.GetActiveContributionsAsync();
        _allContributions = await MemoryAnalytics.GetContributionsSinceAsync(DateTimeOffset.UtcNow.AddDays(-30));
        _activeThread = await Conversations.GetActiveThreadAsync();

        _registerTrend = _allContributions
            .GroupBy(c => c.CreatedAt.LocalDateTime.Date)
            .Select(g => (
                Date: DateOnly.FromDateTime(g.Key),
                UniqueRegisters: g.Select(c => ImpactCategoryDefaults.ToRegisterFamily(c.Register)).Distinct().Count(),
                Total: g.Count()))
            .OrderBy(d => d.Date)
            .TakeLast(14)
            .ToList();

        try { _diagnosticReport = await DiagnosticService.RunDiagnosticAsync(); }
        catch { _diagnosticReport = null; }
    }

    private async Task RunDiagnostic()
    {
        try
        {
            _diagnosticReport = await DiagnosticService.RunDiagnosticAsync();
            StateHasChanged();
        }
        catch { /* diagnostic failure is non-critical */ }
    }

    private EmotionalContribution? FindContributionForThought(MemoryRecord thought)
    {
        // Match by source content prefix — contributions store the first 200 chars of the thought
        var contentPrefix = thought.Content.Length > 50 ? thought.Content[..50] : thought.Content;
        return _contributions.FirstOrDefault(c =>
            c.SourceContent.StartsWith(contentPrefix, StringComparison.OrdinalIgnoreCase));
    }

    private async Task ExpireContribution(Guid id)
    {
        await MemoryMaintenance.ExpireContributionAsync(id);
        var state = await StateStore.GetEmotionalStateAsync();
        _contributions = await MemoryAnalytics.GetActiveContributionsAsync();
        state.ComputeFromContributions(_contributions);
        await MemoryPersist.SaveEmotionalStateAsync(state);
        _emotional = state;
    }

    private void ToggleDrift(Guid id)
    {
        if (!_expandedDrift.Remove(id))
            _expandedDrift.Add(id);
    }

    private void ToggleDimension(string dimension)
    {
        _selectedDimension = _selectedDimension == dimension ? null : dimension;
        _expandedContributions.Clear();
    }

    private void SetSort(string sort)
    {
        _contributionSort = sort;
    }

    private void ToggleExpand(Guid id)
    {
        if (!_expandedContributions.Remove(id))
            _expandedContributions.Add(id);
    }

    private List<EmotionalContribution> GetContributionsForDimension(string dimension)
    {
        var now = DateTimeOffset.UtcNow;
        var filtered = _contributions
            .Where(c => !c.IsEffectivelyZero(now) && Math.Abs(GetDelta(c, dimension)) > 0.001f);

        return _contributionSort switch
        {
            "severity" => filtered.OrderByDescending(c => c.Severity).ToList(),
            "decay" => filtered.OrderByDescending(c => c.DecayFactor(now)).ToList(),
            _ => filtered.OrderByDescending(c => Math.Abs(GetDelta(c, dimension) * c.Severity * (float)c.DecayFactor(now))).ToList(),
        };
    }

    private static float GetDelta(EmotionalContribution c, string dimension) => dimension switch
    {
        "Warmth" => c.WarmthDelta,
        "Energy" => c.EnergyDelta,
        "Worry" => c.WorryDelta,
        "Playfulness" => c.PlayfulnessDelta,
        _ => 0f,
    };

    private static string FormatDelta(float delta) =>
        delta >= 0 ? $"+{delta:F2}" : $"{delta:F2}";

    private static string DeltaColor(float delta) =>
        delta > 0.01f ? "#4caf50" : delta < -0.01f ? "#f44336" : "#888";

    private static string HeatColor(float value)
    {
        // Heatmap: negative values red, zero gray, positive green
        // For severity/decay (0-1): low=red, mid=yellow, high=green
        var abs = Math.Abs(value);
        if (value < -0.01f)
        {
            // Negative: red spectrum (more negative = more red)
            var t = Math.Min(abs / 0.35f, 1f);
            var r = 255;
            var g = (int)(255 * (1 - t * 0.7f));
            var b = (int)(255 * (1 - t * 0.85f));
            return $"rgb({r},{g},{b})";
        }
        if (value > 0.01f)
        {
            // Positive: green spectrum (more positive = more green)
            var t = Math.Min(abs / 0.35f, 1f);
            var r = (int)(255 * (1 - t * 0.7f));
            var g = 255;
            var b = (int)(255 * (1 - t * 0.85f));
            return $"rgb({r},{g},{b})";
        }
        return "#888";
    }
}
