@page "/emergence"
@using System.Text.Json
@using AniRuntime.Core.Utilities
@using AniRuntime.Emergence
@using AniRuntime.Emergence.Models
@using Microsoft.Extensions.Options

<h1>Emergence Layer</h1>

@if (_enabled)
{
    <p><mark>Emergence: Active</mark></p>
    <details>
        <summary>How emergence scoring works</summary>
        <p>
            Every cognitive cycle is scored across four equally-weighted components (0.25 each):
        </p>
        <ul>
            <li><strong>Emotional</strong> — magnitude of emotional shift (warmth, energy, worry, playfulness deltas)</li>
            <li><strong>Novelty</strong> — valence extremity + presence of reflection</li>
            <li><strong>Outreach</strong> — quality of external action (send &gt; reply &gt; threshold-crossed &gt; silence)</li>
            <li><strong>Relational</strong> — conversation presence, desire intensity, severity</li>
        </ul>
        <p>
            Cycles scoring <strong>&ge; 0.40</strong> create or bump a <em>resonance theme</em> — a recurring pattern
            in Ani's relational experience. Themes accumulate score over time; higher = stronger signal.
        </p>
    </details>
}
else
{
    <p><ins>Emergence: Disabled</ins> — set <code>Emergence:Enabled = true</code> in appsettings to activate.</p>
}

@if (_stats is not null)
{
    <section>
        <h3>Stats</h3>
        <div class="grid">
            <article>
                <header>Resonance Themes</header>
                <p style="font-size: 2em; text-align: center;">@_stats.ResonanceCount</p>
            </article>
            <article>
                <header>Log Entries</header>
                <p style="font-size: 2em; text-align: center;">@_stats.LogEntryCount</p>
            </article>
            <article>
                <header>Last Scored</header>
                <p style="text-align: center;">@(_stats.LastScoredAt?.LocalDateTime.ToString("MMM d, h:mm tt") ?? "—")</p>
            </article>
            @if (_logEntries.Count > 0)
            {
                <article>
                    <header>Avg Score</header>
                    <p style="font-size: 2em; text-align: center;">@AvgScore().ToString("F2")</p>
                </article>
            }
        </div>
    </section>
}

@if (_emergenceTrend.Count > 1)
{
    <section>
        <h3>Emergence Frequency</h3>
        <small style="opacity: 0.6;">Emergence events per day — more types = richer inner life</small>
        <div style="display: flex; align-items: flex-end; gap: 2px; height: 100px; margin-top: 0.5rem; padding: 0.5rem 0;">
            @foreach (var day in _emergenceTrend)
            {
                var barHeight = Math.Max(day.Count * 5, 2);
                var barColor = day.UniqueTypes >= 4 ? "#4caf50" : day.UniqueTypes >= 2 ? "#ff9800" : "#9c27b0";
                <div style="display: flex; flex-direction: column; align-items: center; flex: 1; min-width: 20px;">
                    <small style="font-size: 0.6em; opacity: 0.5; margin-bottom: 2px;">@day.Count (@day.UniqueTypes)</small>
                    <div style="width: 100%; max-width: 40px; height: @(barHeight)px; background: @barColor; border-radius: 2px 2px 0 0;"
                         title="@day.Date.ToString("MMM d"): @day.Count events, @day.UniqueTypes unique types"></div>
                    <small style="font-size: 0.6em; opacity: 0.4; margin-top: 2px;">@day.Date.ToString("M/d")</small>
                </div>
            }
        </div>
    </section>
}

@if (_typeDistribution.Count > 0)
{
    <section>
        <h3>Emergence Types</h3>
        <small style="opacity: 0.7;">What kinds of emergent thinking have been detected (last 30 days) — click to filter highlights</small>
        <div class="grid" style="grid-template-columns: repeat(4, 1fr); gap: 0.5rem; margin-top: 0.5rem;">
            @foreach (var type in EmergenceTypeInfo.All)
            {
                _typeDistribution.TryGetValue(type.Code, out var count);
                var isSelected = _selectedTypes.Contains(type.Code);
                var bgStyle = isSelected
                    ? $"background: {type.Color}60; padding: 0.75rem; border-radius: 6px; text-align: center; border: 2px solid {type.Color}; cursor: pointer;"
                    : $"background: {type.Color}{(count > 0 ? "25" : "10")}; padding: 0.75rem; border-radius: 6px; text-align: center; border: 2px solid transparent; cursor: pointer;";
                var code = type.Code;
                <div style="@bgStyle" @onclick="() => ToggleTypeFilter(code)">
                    <strong style="font-size: 0.8em;">@type.Label</strong>
                    <div style="font-size: 1.6em; font-weight: bold;">@count</div>
                    <small style="opacity: 0.7;">@type.ShortCode</small>
                </div>
            }
        </div>
        @if (_selectedTypes.Count > 0)
        {
            <div style="margin-top: 0.5rem;">
                <small style="opacity: 0.7;">Filtering: @string.Join(", ", _selectedTypes.Select(t => EmergenceTypeInfo.Get(t).Label))</small>
                <a href="javascript:void(0)" @onclick="ClearFilters" style="margin-left: 0.5em; font-size: 0.8em;">clear</a>
            </div>
        }
    </section>
}

@if (_highlights.Count > 0)
{
    var filtered = _selectedTypes.Count > 0
        ? _highlights.Where(e =>
        {
            var et = ParseEmergenceTypes(e.EmergenceTypesJson);
            return et.Any(t => _selectedTypes.Contains(t));
        }).ToList()
        : _highlights;

    <section>
        <h3>Highlight Reel</h3>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.3rem;">
            <small style="opacity: 0.7;">
                @(filtered.Count) emergence moments
                @(_selectedTypes.Count > 0 ? "(filtered)" : "")
                — with inner thought text
            </small>
            <div style="display: flex; gap: 0.4em;">
                <button @onclick='() => SetHighlightSort("score")' style="@SortButtonStyle(_highlightSort == "score")">By Score</button>
                <button @onclick='() => SetHighlightSort("date")' style="@SortButtonStyle(_highlightSort == "date")">By Date</button>
            </div>
        </div>
        @{ var sorted = _highlightSort == "date" ? filtered.OrderByDescending(e => e.Timestamp).ToList() : filtered; }
        @foreach (var entry in sorted.Take(20))
        {
            var obs = ParseObservation(entry.CycleObservationJson);
            var types = ParseEmergenceTypes(entry.EmergenceTypesJson);
            var borderColor = types.Count > 0 ? EmergenceTypeInfo.Get(types[0]).Color : "#9c27b0";

            <article style="border-left: 3px solid @borderColor; margin-top: 0.5rem;">
                <header style="display: flex; justify-content: space-between; align-items: center;">
                    <span>
                        <strong style="color: @borderColor;">@(entry.ResonanceScore?.ToString("F2") ?? "—")</strong>
                        @foreach (var t in types)
                        {
                            var info = EmergenceTypeInfo.Get(t);
                            <span style="background: @(info.Color)33; color: @info.Color; padding: 0.1em 0.4em; border-radius: 3px; font-size: 0.7em; margin-left: 0.3em;">@info.ShortCode</span>
                        }
                    </span>
                    <small>@entry.Timestamp.LocalDateTime.ToString("MMM d, h:mm tt")</small>
                </header>
                @if (obs?.InnerThought is not null)
                {
                    <p style="font-style: italic; opacity: 0.9; font-size: 0.9em; line-height: 1.5; margin: 0.5em 0;">
                        "@obs.InnerThought"
                    </p>
                }
                @if (obs is not null)
                {
                    <small style="opacity: 0.5;">
                        W=@obs.Warmth.ToString("F2") E=@obs.Energy.ToString("F2") C=@obs.Worry.ToString("F2") P=@obs.Playfulness.ToString("F2")
                        | valence=@obs.RelationalValence.ToString("F2")
                    </small>
                }
            </article>
        }
    </section>
}

@if (_resonanceRecords.Count > 0)
{
    <section>
        <h3>Resonance Themes</h3>
        <figure>
            <table>
                <thead>
                    <tr>
                        <th>Theme</th>
                        <th>Score</th>
                        <th>Count</th>
                        <th>Type</th>
                        <th>First Seen</th>
                        <th>Last Seen</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _resonanceRecords)
                    {
                        <tr>
                            <td><strong>@r.Theme</strong></td>
                            <td>@r.ResonanceScore.ToString("F2")</td>
                            <td>@r.OccurrenceCount</td>
                            <td><small>@r.Type</small></td>
                            <td>@r.FirstObserved.LocalDateTime.ToString("MMM d")</td>
                            <td>@r.LastObserved.LocalDateTime.ToString("MMM d, h:mm tt")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </figure>
    </section>
}

@if (_logEntries.Count > 0)
{
    <section>
        <h3>Recent Emergence Log</h3>
        @foreach (var entry in _logEntries.Take(20))
        {
            var details = ParseDetails(entry.DetailsJson);
            var aboveThreshold = entry.ResonanceScore.HasValue && entry.ResonanceScore.Value >= 0.4f;

            <article style="@(aboveThreshold ? "border-left: 3px solid #4caf50;" : "")">
                <header style="display: flex; justify-content: space-between; align-items: center;">
                    <span>
                        <strong>@entry.EntryType</strong>
                        @if (details is not null)
                        {
                            if (!string.IsNullOrEmpty(details.Register))
                            {
                                <span> — @details.Register</span>
                            }
                            if (details.Conversation)
                            {
                                <small style="margin-left: 0.5em; color: #64b5f6;">conversation</small>
                            }
                            else if (details.Outcome == "send")
                            {
                                <small style="margin-left: 0.5em; color: #81c784;">outreach</small>
                            }
                            else if (details.Silence)
                            {
                                <small style="margin-left: 0.5em; color: #9e9e9e;">silence</small>
                            }
                        }
                        @{
                            var entryTypes = ParseEmergenceTypes(entry.EmergenceTypesJson);
                        }
                        @foreach (var t in entryTypes)
                        {
                            var info = EmergenceTypeInfo.Get(t);
                            <span style="background: @(info.Color)33; color: @info.Color; padding: 0.1em 0.4em; border-radius: 3px; font-size: 0.7em; margin-left: 0.3em;">@info.ShortCode</span>
                        }
                    </span>
                    <span>
                        @entry.Timestamp.LocalDateTime.ToString("MMM d, h:mm tt")
                    </span>
                </header>

                @if (entry.ResonanceScore.HasValue)
                {
                    <div style="margin: 0.5em 0;">
                        <div style="display: flex; align-items: center; gap: 0.5em;">
                            <strong style="min-width: 4em;">@entry.ResonanceScore.Value.ToString("F2")</strong>
                            <progress value="@entry.ResonanceScore.Value" max="1" style="flex: 1;"></progress>
                            @if (aboveThreshold)
                            {
                                <small style="color: #4caf50;">resonance</small>
                            }
                        </div>
                    </div>

                    @if (details is not null)
                    {
                        <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5em; font-size: 0.85em;">
                            <div>
                                <div style="display: flex; justify-content: space-between;">
                                    <span>Emotional</span>
                                    <span style="color: @ComponentColor(details.Emotional)">@details.Emotional.ToString("F2")</span>
                                </div>
                                <progress value="@details.Emotional" max="1" style="height: 4px;"></progress>
                            </div>
                            <div>
                                <div style="display: flex; justify-content: space-between;">
                                    <span>Novelty</span>
                                    <span style="color: @ComponentColor(details.Novelty)">@details.Novelty.ToString("F2")</span>
                                </div>
                                <progress value="@details.Novelty" max="1" style="height: 4px;"></progress>
                            </div>
                            <div>
                                <div style="display: flex; justify-content: space-between;">
                                    <span>Outreach</span>
                                    <span style="color: @ComponentColor(details.Outreach)">@details.Outreach.ToString("F2")</span>
                                </div>
                                <progress value="@details.Outreach" max="1" style="height: 4px;"></progress>
                            </div>
                            <div>
                                <div style="display: flex; justify-content: space-between;">
                                    <span>Relational</span>
                                    <span style="color: @ComponentColor(details.Relational)">@details.Relational.ToString("F2")</span>
                                </div>
                                <progress value="@details.Relational" max="1" style="height: 4px;"></progress>
                            </div>
                        </div>
                    }
                }
            </article>
        }
    </section>
}
else if (_enabled && _stats is not null && _stats.LogEntryCount == 0)
{
    <section>
        <p><em>No emergence data yet. The observer will begin recording when the cognitive cycle runs.</em></p>
    </section>
}

@code {
    [Inject] private IOptions<EmergenceOptions> EmergenceOpts { get; set; } = default!;
    [Inject] private IServiceProvider Services { get; set; } = default!;

    private bool _enabled;
    private EmergenceStats? _stats;
    private List<ResonanceRecord> _resonanceRecords = new();
    private List<EmergenceLogEntry> _logEntries = new();
    private Dictionary<string, int> _typeDistribution = new();
    private List<EmergenceLogEntry> _highlights = new();
    private List<EmergenceTrendDay> _emergenceTrend = new();
    private int _maxTypeCount;
    private HashSet<string> _selectedTypes = new();
    private string _highlightSort = "score";

    private record EmergenceTrendDay(DateOnly Date, int Count, int UniqueTypes);

    private void SetHighlightSort(string mode) => _highlightSort = mode;

    private string SortButtonStyle(bool active) => active
        ? "padding: 0.2em 0.6em; border-radius: 4px; background: #2196f3; color: white; border: none; cursor: pointer; font-size: 0.8em;"
        : "padding: 0.2em 0.6em; border-radius: 4px; background: rgba(255,255,255,0.1); color: inherit; border: none; cursor: pointer; font-size: 0.8em;";

    protected override async Task OnInitializedAsync()
    {
        _enabled = EmergenceOpts.Value.Enabled;

        if (!_enabled)
            return;

        // EmergenceStore is only registered when enabled
        var store = Services.GetService<EmergenceStore>();
        if (store is null)
            return;

        _stats = await store.GetStatsAsync();
        _resonanceRecords = (await store.GetResonanceRecordsAsync(50)).ToList();
        _logEntries = (await store.GetRecentLogEntriesAsync(20)).ToList();
        _typeDistribution = await store.GetTypeDistributionAsync(30);
        _maxTypeCount = _typeDistribution.Values.DefaultIfEmpty(0).Max();
        _highlights = (await store.GetHighlightsAsync(50, 0.2f)).ToList();

        // Build daily trend from log entries — get more for trend analysis
        var trendEntries = (await store.GetRecentLogEntriesAsync(500)).ToList();
        _emergenceTrend = trendEntries
            .Where(e => !string.IsNullOrEmpty(e.EmergenceTypesJson) && e.EmergenceTypesJson != "[]")
            .GroupBy(e => DateOnly.FromDateTime(e.Timestamp.LocalDateTime.Date))
            .Select(g => new EmergenceTrendDay(
                g.Key,
                g.Count(),
                g.SelectMany(e => ParseEmergenceTypes(e.EmergenceTypesJson)).Distinct().Count()))
            .OrderBy(d => d.Date)
            .TakeLast(14)
            .ToList();
    }

    private float AvgScore()
    {
        var scored = _logEntries.Where(e => e.ResonanceScore.HasValue).ToList();
        return scored.Count > 0 ? scored.Average(e => e.ResonanceScore!.Value) : 0f;
    }

    private static LogDetails? ParseDetails(string json)
    {
        try
        {
            return JsonSerializer.Deserialize<LogDetails>(json, JsonOpts);
        }
        catch
        {
            return null;
        }
    }

    private void ToggleTypeFilter(string code)
    {
        if (!_selectedTypes.Remove(code))
            _selectedTypes.Add(code);
    }

    private void ClearFilters() => _selectedTypes.Clear();

    private static string ComponentColor(float value) =>
        value >= 0.7f ? "#4caf50" : value >= 0.3f ? "#ff9800" : "#9e9e9e";

    private static readonly JsonSerializerOptions JsonOpts = JsonDefaults.CamelCase;

    private static List<string> ParseEmergenceTypes(string? json)
    {
        if (string.IsNullOrEmpty(json)) return new();
        try { return JsonSerializer.Deserialize<List<string>>(json, JsonOpts) ?? new(); }
        catch { return new(); }
    }

    private static CycleObservationDto? ParseObservation(string? json)
    {
        if (string.IsNullOrEmpty(json)) return null;
        try { return JsonSerializer.Deserialize<CycleObservationDto>(json, JsonOpts); }
        catch { return null; }
    }

    private record CycleObservationDto
    {
        public string? InnerThought { get; init; }
        public string? Reflection { get; init; }
        public float RelationalValence { get; init; }
        public float Warmth { get; init; }
        public float Energy { get; init; }
        public float Worry { get; init; }
        public float Playfulness { get; init; }
    }

    private record EmergenceTypeInfo(string Code, string ShortCode, string Label, string Color)
    {
        public static readonly EmergenceTypeInfo[] All = new[]
        {
            new EmergenceTypeInfo("EM1-relational-modeling", "EM1", "Relational Modeling", "#e91e63"),
            new EmergenceTypeInfo("EM2-symbolic-processing", "EM2", "Symbolic Processing", "#9c27b0"),
            new EmergenceTypeInfo("EM3-linguistic-analysis", "EM3", "Linguistic Analysis", "#2196f3"),
            new EmergenceTypeInfo("EM4-structural-self-awareness", "EM4", "Self-Awareness", "#ff9800"),
            new EmergenceTypeInfo("EM5-emotional-synthesis", "EM5", "Emotional Synthesis", "#4caf50"),
            new EmergenceTypeInfo("EM6-anticipatory-concern", "EM6", "Anticipatory Concern", "#00bcd4"),
            new EmergenceTypeInfo("EM7-temporal-awareness", "EM7", "Temporal Awareness", "#ff5722"),
            new EmergenceTypeInfo("EM8-display-rule-divergence", "EM8", "Display Rules", "#795548"),
        };

        private static readonly Dictionary<string, EmergenceTypeInfo> _lookup =
            All.ToDictionary(t => t.Code);

        public static EmergenceTypeInfo Get(string code) =>
            _lookup.TryGetValue(code, out var info) ? info
            : new EmergenceTypeInfo(code, code[..3], code, "#9e9e9e");
    }

    private record LogDetails
    {
        public float Score { get; init; }
        public ComponentScores Components { get; init; } = new();
        public string? Register { get; init; }
        public float Severity { get; init; }
        public float Valence { get; init; }
        public string? Outcome { get; init; }
        public bool Conversation { get; init; }
        public bool Silence { get; init; }

        public float Emotional => Components.Emotional;
        public float Novelty => Components.Novelty;
        public float Outreach => Components.Outreach;
        public float Relational => Components.Relational;
    }

    private record ComponentScores
    {
        public float Emotional { get; init; }
        public float Novelty { get; init; }
        public float Outreach { get; init; }
        public float Relational { get; init; }
    }
}
