@page "/chat"
@using AniRuntime.Core
@using AniRuntime.Core.Interfaces
@using AniRuntime.Core.Models
@inject IConversationService Conversations
@inject IChatInbound ChatInbound
@inject IJSRuntime JS
@implements IDisposable

<div class="chat-page">
<h1>Chat with Ani</h1>
<p><small>Messages flow through the full cognitive pipeline — no Twilio credits needed.</small></p>

<section class="chat-container">
    <div class="chat-messages" @ref="_messagesDiv">
        @foreach (var msg in _messages)
        {
            <div class="chat-bubble @(msg.Role == "mark" ? "chat-user" : "chat-ani")">
                <span class="chat-role">@(msg.Role == "mark" ? "Mark" : "Ani")</span>
                <span class="chat-text">@msg.Content</span>
                <span class="chat-time">
                    @msg.SentAt.LocalDateTime.ToString("h:mm:ss tt")
                    <span class="chat-copy" @onclick="() => CopyToClipboard(msg.Content)" title="Copy">&#128203;</span>
                </span>
            </div>
        }
        @if (_waiting)
        {
            <div class="chat-bubble chat-ani chat-thinking">
                <span class="chat-role">Ani</span>
                <span class="typing-indicator">
                    <span class="dot"></span>
                    <span class="dot"></span>
                    <span class="dot"></span>
                </span>
            </div>
        }
    </div>

    <div class="chat-input-wrapper">
        <input type="text"
               @bind="_inputText"
               @bind:event="oninput"
               @onkeyup="HandleKeyUp"
               placeholder="Type a message..."
               disabled="@_waiting" />
        <span class="chat-send-btn" @onclick="SendMessage">&#9654;</span>
    </div>
</section>
</div>

<style>
    .chat-page {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 120px);
        overflow: hidden;
    }
    .chat-page h1 { margin-bottom: 0.2rem; }
    .chat-page p { margin-bottom: 0.5rem; }

    .chat-container {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-height: 0;
        overflow: hidden;
    }
    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        background: var(--pico-card-background-color);
        border-radius: var(--pico-border-radius);
        margin-bottom: 1rem;
    }
    .chat-bubble {
        padding: 0.5rem 0.8rem;
        border-radius: 12px;
        max-width: 80%;
        word-wrap: break-word;
    }
    .chat-user {
        align-self: flex-end;
        background: #1a73e8;
        color: white;
    }
    .chat-ani {
        align-self: flex-start;
        background: #333;
        color: #e0e0e0;
    }
    .chat-thinking {
        opacity: 0.7;
    }
    .typing-indicator {
        display: flex;
        gap: 4px;
        padding: 4px 0;
    }
    .typing-indicator .dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #999;
        animation: typing-bounce 1.4s infinite ease-in-out;
    }
    .typing-indicator .dot:nth-child(2) {
        animation-delay: 0.2s;
    }
    .typing-indicator .dot:nth-child(3) {
        animation-delay: 0.4s;
    }
    @@keyframes typing-bounce {
        0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
        30% { transform: translateY(-6px); opacity: 1; }
    }
    .chat-role {
        display: block;
        font-size: 0.7em;
        font-weight: bold;
        margin-bottom: 0.2em;
        opacity: 0.7;
    }
    .chat-time {
        display: flex;
        align-items: center;
        gap: 0.4em;
        font-size: 0.65em;
        opacity: 0.5;
        margin-top: 0.2em;
    }
    .chat-copy {
        cursor: pointer;
        opacity: 0.4;
        font-size: 1.1em;
        transition: opacity 0.15s;
    }
    .chat-copy:hover {
        opacity: 1;
    }
    .chat-text {
        display: block;
        line-height: 1.4;
    }
    .chat-input-form {
        margin: 0;
    }
    .chat-input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }
    .chat-input-wrapper input {
        flex: 1;
        margin-bottom: 0;
        padding-right: 3rem;
    }
    .chat-send-btn {
        position: absolute;
        right: 0.5rem;
        top: 50%;
        transform: translateY(-50%);
        background: none !important;
        border: none !important;
        color: #1a73e8;
        font-size: 1.2rem;
        cursor: pointer;
        padding: 0.3rem 0.5rem;
        margin: 0;
        width: auto !important;
        min-width: auto;
        line-height: 1;
        z-index: 1;
    }
    .chat-send-btn:hover:not(:disabled) {
        color: #4a9eff;
    }
    .chat-send-btn:disabled {
        color: #555;
        cursor: default;
    }
</style>

@code {
    private string _inputText = string.Empty;
    private bool _waiting;
    private List<ConversationMessage> _messages = new();
    private ElementReference _messagesDiv;
    private Timer? _pollTimer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("eval", "document.body.style.overflow='hidden'");
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadMessages();

        // Poll for new messages every 2 seconds while waiting for a reply
        _pollTimer = new Timer(async _ =>
        {
            try
            {
                var previousCount = _messages.Count;
                await LoadMessages();
                if (_messages.Count > previousCount)
                {
                    // New message arrived — check if it's from Ani
                    var latest = _messages[^1];
                    if (latest.Role == Roles.Ani)
                        _waiting = false;

                    await InvokeAsync(StateHasChanged);
                }
            }
            catch { /* timer callback — don't crash */ }
        }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(2));
    }

    private async Task LoadMessages()
    {
        // Show messages from the active thread first, fall back to most recent
        var thread = await Conversations.GetActiveThreadAsync();
        if (thread is null)
        {
            var recent = await Conversations.GetRecentThreadsAsync(1);
            thread = recent.FirstOrDefault();
        }

        if (thread is not null)
            _messages = thread.Messages.ToList();
        else
            _messages = new();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SendMessage();
    }

    private async Task SendMessage()
    {
        var text = _inputText?.Trim();
        if (string.IsNullOrWhiteSpace(text)) return;

        _inputText = string.Empty;
        _waiting = true;

        // Enqueue through the IChatInbound abstraction — generates a synthetic
        // DASHBOARD- SID so the reply channel resolver routes to dashboard, not SMS.
        ChatInbound.EnqueueMessage(text);

        // Add the user message to the display immediately
        _messages.Add(new ConversationMessage
        {
            Role = Roles.Mark,
            Content = text,
            SentAt = DateTimeOffset.UtcNow
        });

        StateHasChanged();
    }

    private async Task CopyToClipboard(string text)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
    }

    public void Dispose()
    {
        _pollTimer?.Dispose();
        _ = JS.InvokeVoidAsync("eval", "document.body.style.overflow=''");
    }
}
