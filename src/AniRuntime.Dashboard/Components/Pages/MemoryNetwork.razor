@page "/network"
@using System.Text.Json
@using AniRuntime.Core.Interfaces
@using AniRuntime.Core.Models
@using AniRuntime.Core.Utilities
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject IServiceProvider Services

<h1>Memory Network</h1>
@if (_loading)
{
    <p><em>Loading memory graph...</em></p>
}
else
{
    <p>Ani's memory as a living graph — @_nodeCount nodes, @_edgeCount links.</p>
}

<div style="display: flex; gap: 0.5em; margin-bottom: 0.5rem; flex-wrap: wrap;">
    <button @onclick='() => SetColorMode("type")' style="@ButtonStyle(_colorMode == "type")">Color by Type</button>
    <button @onclick='() => SetColorMode("importance")' style="@ButtonStyle(_colorMode == "importance")">Color by Importance</button>
    <button @onclick='() => SetColorMode("age")' style="@ButtonStyle(_colorMode == "age")">Color by Recency</button>
    <button @onclick="ToggleOrbit" style="@ButtonStyle(_orbiting)">@(_orbiting ? "⏹ Stop Orbit" : "🎬 Auto-Orbit")</button>
    @if (_orbiting)
    {
        <label style="display: flex; align-items: center; gap: 0.4em; font-size: 0.85em;">
            Zoom:
            <input type="range" min="300" max="1500" value="@_orbitDistance" step="50"
                   @oninput="OnZoomChange" style="width: 120px;" />
            <span style="opacity: 0.6; min-width: 2em;">@_orbitDistance</span>
        </label>
    }
</div>

<div style="display: flex; gap: 1em; font-size: 0.8em; margin-bottom: 0.5rem; flex-wrap: wrap;">
    @if (_colorMode == "type")
    {
        <span><span style="color: #2196f3;">●</span> Semantic</span>
        <span><span style="color: #4caf50;">●</span> Episodic</span>
        <span><span style="color: #ff9800;">●</span> Perception</span>
        <span><span style="color: #9c27b0;">●</span> InnerThought</span>
        <span><span style="color: #f44336;">●</span> Reflection</span>
        <span><span style="color: #607d8b;">●</span> Other</span>
    }
    else if (_colorMode == "importance")
    {
        <span><span style="color: #f44336;">●</span> High (0.8+)</span>
        <span><span style="color: #ff9800;">●</span> Medium (0.5-0.8)</span>
        <span><span style="color: #607d8b;">●</span> Low (under 0.5)</span>
    }
    else
    {
        <span><span style="color: #4caf50;">●</span> Recent (24h)</span>
        <span><span style="color: #ff9800;">●</span> This week</span>
        <span><span style="color: #607d8b;">●</span> Older</span>
    }
</div>

<div id="graph-container" style="width: 100%; height: 700px; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; background: #0a0a1a;"></div>

<div id="node-detail" style="display: none; margin-top: 1rem; padding: 1rem; background: rgba(255,255,255,0.05); border-radius: 8px;">
    <h4 id="detail-type" style="margin: 0;"></h4>
    <p id="detail-content" style="font-style: italic; margin: 0.5em 0;"></p>
    <small id="detail-meta" style="opacity: 0.5;"></small>
</div>

@code {
    private int _nodeCount;
    private int _edgeCount;
    private string _colorMode = "type";
    private string? _graphJson;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        // Load data server-side — avoids JS fetch timeout issues
        var memory = Services.GetService<IMemoryService>();
        var maintenance = Services.GetService<IMemoryMaintenance>();
        if (memory is null || maintenance is null) return;

        var allMemories = new List<MemoryRecord>();
        foreach (var type in Enum.GetValues<MemoryType>())
        {
            var records = await memory.GetByTypeAsync(type, 500);
            allMemories.AddRange(records);
        }
        var links = await maintenance.GetAllLinksAsync();

        var nodeIds = new HashSet<string>(allMemories.Select(r => r.Id.ToString()));
        var nodes = allMemories.Select(r => new
        {
            id = r.Id.ToString(),
            type = r.Type.ToString(),
            content = r.Content.Length > 150 ? r.Content[..150] + "..." : r.Content,
            importance = r.Importance,
            isAnchored = r.AnchoredAt.HasValue,
            createdAt = r.CreatedAt,
        }).ToList();

        // Filter links to only include those where both source and target exist in our node set
        var validLinks = links
            .Where(l => nodeIds.Contains(l.SourceId.ToString()) && nodeIds.Contains(l.TargetId.ToString()))
            .Select(l => new
            {
                source = l.SourceId.ToString(),
                target = l.TargetId.ToString(),
                relationship = l.Relationship,
            }).ToList();

        _nodeCount = nodes.Count;
        _edgeCount = validLinks.Count;
        // 3d-force-graph expects { nodes: [...], links: [...] }
        _graphJson = JsonSerializer.Serialize(new { nodes, links = validLinks }, JsonDefaults.CamelCase);
        _loading = false;
    }

    private bool _jsInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Skip prerender — JS isn't available yet during ServerPrerendered.
        // Init on first render after data is loaded.
        if (!_jsInitialized && _graphJson is not null)
        {
            _jsInitialized = true;
            try
            {
                // Small delay to ensure external JS file has loaded
                await Task.Delay(500);
                var json = JsonSerializer.Deserialize<JsonElement>(_graphJson);
                await JS.InvokeVoidAsync("aniGraph.init", json, _colorMode);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Graph init failed: {ex.Message}");
            }
        }
    }

    private async Task SetColorMode(string mode)
    {
        _colorMode = mode;
        await JS.InvokeVoidAsync("aniGraph.updateColorMode", mode);
    }

    private bool _orbiting;
    private int _orbitDistance = 800;

    private async Task ToggleOrbit()
    {
        _orbiting = await JS.InvokeAsync<bool>("aniGraph.toggleOrbit");
    }

    private async Task OnZoomChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
        {
            _orbitDistance = val;
            await JS.InvokeVoidAsync("aniGraph.setOrbitDistance", val);
        }
    }

    private string ButtonStyle(bool active) => active
        ? "padding: 0.3em 0.8em; border-radius: 4px; background: #2196f3; color: white; border: none; cursor: pointer;"
        : "padding: 0.3em 0.8em; border-radius: 4px; background: rgba(255,255,255,0.1); color: inherit; border: none; cursor: pointer;";
}
